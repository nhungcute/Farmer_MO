APP_ENV=local
DEMO_MODE=true
NODE_ENV=development
TZ=UTC
NODE_VERSION=22
POSTGRES_DB=mo_farm
POSTGRES_USER=mo_farm
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://mo_farm:change_me@db:5432/mo_farm
# File storage is for the local prototype only. Public E01 requires postgres;
# see docs/implementation/tasks/E01_PERSISTENT_QUICK_TUNNEL.md for demo settings.
PERSISTENCE_DRIVER=file
SESSION_SECRET=change_me_minimum_32_chars
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# Local default derives http://localhost:${NGINX_PORT}. Quick Tunnel tooling
# captures and injects the exact generated HTTPS origin, then records it in
# .runtime/quick-tunnel.env for inspection.
PUBLIC_ORIGIN=
TRUST_PROXY=false
LOG_LEVEL=info
METRICS_PUBLIC=false
VITE_API_BASE=/api
API_PORT=3000
WEB_PORT=4173
NGINX_PORT=8080
POSTGRES_PORT=5432
STATE_FILE=/data/farm-state.json
BACKUP_DIR=./backups
