APP_ENV=local
DEMO_MODE=true
NODE_ENV=development
TZ=UTC
NODE_VERSION=22
POSTGRES_DB=mo_farm
POSTGRES_USER=mo_farm
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://mo_farm:change_me@db:5432/mo_farm
# Keep file for the demo. Switch to postgres only after A02 parity/concurrency gates pass.
PERSISTENCE_DRIVER=file
SESSION_SECRET=change_me_minimum_32_chars
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# Local default derives http://localhost:${NGINX_PORT}. Named Tunnel deployment
# requires the exact fixed HTTPS origin matching CLOUDFLARE_HOSTNAME.
PUBLIC_ORIGIN=
TRUST_PROXY=false
LOG_LEVEL=info
METRICS_PUBLIC=false
VITE_API_BASE=/api
API_PORT=3000
WEB_PORT=4173
NGINX_PORT=8080
POSTGRES_PORT=5432
STATE_FILE=/data/farm-state.json
# Named Tunnel credentials stay in the ignored local environment.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_HOSTNAME=farm.example.com
BACKUP_DIR=./backups
